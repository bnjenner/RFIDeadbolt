{
    "device": "/dev/ttyACM0",
    "baudrate": 115200,
    "hash_file": "__HASH_FILE__",
    "session_unlock": "loginctl unlock-session",
    "session_query": "gdbus call --session --dest org.freedesktop.ScreenSaver --object-path /org/freedesktop/ScreenSaver --method org.freedesktop.ScreenSaver.GetActive"
}
